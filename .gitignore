__pycache__/
_tmppip/

# 本地依赖与产物（不入库）
#   .deps/    离线依赖（tools/fetch_python_pack.py 解包安装；本机 pip 无网时的兜底）
#   .deps2/   临时依赖目录（验证 tabpfn 2.x 与 torch 2.4 路线用）
#   models/   第三方权重（TabPFN ckpt 29MB；随服务器包分发，不进 git）
#   dist/     服务器上传包（tools/make_server_bundle.py 生成）
.deps/
.deps2/
models/
dist/

# 数据与生成产物（体积较大，不提交到 git）
#   data/          原始数据（21 GB，只读）
#   features/      特征表；其中 features/v2/ablation/ 是消融中间件，可随时删（见该目录 README）
#   predictions/   出图产物（shp/tif/csv/png）
#   layers/        地质图层（由 tills/v2_build_geology_layers.py 生成）
#   results/       结论报告 + results/runs/ 逐次运行 JSON
# 说明：这些目录内的 README.md 是目录导航/生成物，随目录一起不入库；
#       项目级导航在 docs/ 下（docs/项目结构.md、docs/README.md）。
data/
features/
predictions/
layers/
results/

# 压缩包
*.zip
# docx 不入库
*.docx
# 本地地质叠置验证的独立依赖（不属于服务器补丁）
.geo_deps/

# 旧版本遗留文件（已归档，不入库）
archive/

tmp/

# Local mapping/reporting workspace; retain files locally, exclude from Git.
/archive/local_work_*/
/symbology-style.db
/symbology-style.db-*

# V2 archive navigation, provenance and historical documentation stay reviewable.
# Large snapshots, returned data and installers remain excluded.
!archive/
archive/*
!archive/v2/
archive/v2/*
!archive/v2/README.md
!archive/v2/docs/
!archive/v2/root_docs/
!archive/v2/snapshot_manifest.json
!archive/v2/organization_journal.json

# Minimal V3 training payload. Keep frozen manifests and all their file entries.
!data/
data/*
!data/v3/
data/v3/*
!data/v3/context_ids.json
!features/
features/*
!features/v3/
features/v3/*
!features/v3/model_inputs/
!features/v3/control_reference_s42/
!features/v3/explain_reference_s42/

# Generated output, packages, dependencies and local credentials.
deliverables/
tools/wheels/
wheels/
logs/
