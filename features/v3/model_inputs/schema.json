  "temporal_definitions": [
    {
      "feature": "k2_ndvi_mean",
      "window": "T-2,T-1",
      "operator": "mean",
      "unit": "NDVI"
    },
    {
      "feature": "k2_ndvi_change",
      "window": "mean(T-2,T-1) minus mean(2000..T-1)",
      "operator": "difference, not percent change",
      "unit": "NDVI"
    },
    {
      "feature": "k2_maxdaily_max",
      "window": "T-2,T-1",
      "operator": "maximum of annual maximum daily rain",
      "unit": "mm"
    },
    {
      "feature": "k2_max30d_max",
      "window": "T-2,T-1",
      "operator": "maximum of annual maximum 30-day rain",
      "unit": "mm"
    },
    {
      "feature": "k2_heavydays_sum",
      "window": "T-2,T-1",
      "operator": "sum of annual heavy-rain days",
      "unit": "day"
    },
    {
      "feature": "k2_cumulative_mean",
      "window": "T-2,T-1",
      "operator": "mean of annual cumulative rain, not two-year sum",
      "unit": "mm/year"
    },
    {
      "feature": "ant_1m",
      "window": "previous 1 complete calendar month",
      "operator": "sum",
      "unit": "mm"
    },
    {
      "feature": "ant_3m",
      "window": "previous 3 complete calendar months",
      "operator": "sum",
      "unit": "mm"
    },
    {
      "feature": "ant_6m",
      "window": "previous 6 complete calendar months",
      "operator": "sum",
      "unit": "mm"
    },
    {
      "feature": "wet_season_frac",
      "window": "May–September in T-1 / annual total in T-1",
      "operator": "fraction",
      "unit": "1"
    },
    {
      "feature": "cropland_frac",
      "window": "T-1",
      "operator": "cropland proportion",
      "unit": "fraction"
    },
    {
      "feature": "builtup_frac",
      "window": "T-1",
      "operator": "built-up proportion",
      "unit": "fraction"
    },
    {
      "feature": "lu_builtup_delta",
      "window": "T-1 minus T-2",
      "operator": "built-up proportion difference, not relative percent",
      "unit": "fraction difference"
    },
    {
      "feature": "lu_cropland_delta",
      "window": "T-1 minus T-2",
      "operator": "cropland proportion difference, not relative percent",
      "unit": "fraction difference"
    },
    {
      "feature": "lu_change_freq",
      "window": "T-2 to T-1",
      "operator": "one transition: either proportion changes by >0.02; values 0/1",
      "unit": "count"
    }
  ],
  "missing": "Kept as NaN until context-only imputation/scaling",
  "zone": "preevent_inundation_fraction > 0; missing background excluded from this subgroup, all-population metric retains every unit",
  "purpose": "Retrospective within-study-area geographic transfer; not prospective risk"
}